# Copiar como .env y completar la contrasena.  cp .env.example .env
#
# EL .env NUNCA SE SUBE AL REPOSITORIO. Ya esta en .gitignore.
# La contrasena de Aiven se comparte por el grupo del equipo, no por GitHub.

# ============================================================================
# OPCION A · Aiven  (desarrollo, dias 1 al 5 — los 5 contra la misma base)
# ============================================================================
DB_HOST=storagecluster-robertdenilo2005-eebb.a.aivencloud.com
DB_PORT=20229
DB_USER=avnadmin
DB_PASSWORD=PEGAR_AQUI_LA_CLAVE_QUE_PASO_ROBERT
DB_NAME=defaultdb
DB_SSL_CA=db/ca.pem
DB_POOL_SIZE=10

# ============================================================================
# OPCION B · MySQL local  (desde el dia 6 — con esto se hace la DEMO)
