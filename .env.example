# --- Servidor de sockets ---
SOCKET_HOST=0.0.0.0
SOCKET_PORT=5050
MAX_NODOS=9

# --- Reglas de monitoreo ---
INTERVALO_DEFECTO_SEG=10
FACTOR_TIMEOUT=3
PERIODO_WATCHDOG_SEG=2
PERIODO_DESPACHADOR_SEG=1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
