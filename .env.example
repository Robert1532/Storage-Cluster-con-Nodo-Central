# Copiar como .env y completar la contrasena.  cp .env.example .env
#
# EL .env NUNCA SE SUBE AL REPOSITORIO. Ya esta en .gitignore.
# La contrasena de Aiven se comparte por el grupo del equipo, no por GitHub.

# ============================================================================
# OPCION A · Aiven  (desarrollo, dias 1 al 5 — los 5 contra la misma base)
# ============================================================================
DB_HOST=storagecluster-robertdenilo2005-eebb.a.aivencloud.com
DB_PORT=20229
DB_USER=avnadmin
DB_PASSWORD=PEGAR_AQUI_LA_CLAVE_QUE_PASO_ROBERT
DB_NAME=defaultdb
DB_SSL_CA=db/ca.pem
# Conexiones simultaneas que abre ESTE proceso. Con una conexion por hilo, es
# el techo de hilos que tocan la base a la vez. Con 10 nodos + el hilo
# principal, un valor de 10 hace saltar el aviso "hay 11 conexiones abiertas".
DB_POOL_SIZE=16

# ============================================================================
# OPCION B · MySQL local  (desde el dia 6 — con esto se hace la DEMO)
# Comentar el bloque de arriba y descomentar este.
# ============================================================================
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=cns_app
# DB_PASSWORD=cambiar_esto
# DB_NAME=cns_cluster
# DB_SSL_CA=
# DB_POOL_SIZE=16

# --- Servidor de sockets ---
SOCKET_HOST=0.0.0.0
SOCKET_PORT=5050
# El enunciado pide "soporte exacto para 9 clientes" y el servidor lo respeta:
# rechaza al que sobra con un ERROR explicito. Pero el limite es un PARAMETRO,
# porque el cluster real crece: La Paz tiene DOS servidores y en la demo se
# agrega una computadora mas en caliente (requisito 7.2).
#   MAX_NODOS=9   -> para demostrar el rechazo del decimo en la defensa
#   MAX_NODOS=12  -> para la demo completa con las 9 regionales + extras
MAX_NODOS=12

# --- Reglas de monitoreo ---
INTERVALO_DEFECTO_SEG=10
FACTOR_TIMEOUT=3
PERIODO_WATCHDOG_SEG=2
PERIODO_DESPACHADOR_SEG=1

# --- Que mide cada nodo (v2) ---
# Lista separada por comas. Es solo el valor POR DEFECTO: se puede cambiar por
# nodo desde el dashboard, en caliente, sin tocar esa maquina.
#   disco   el primer disco (obligatorio: es el del enunciado)
#   discos  TODAS las unidades, incluido un pendrive enchufado
#   ram     memoria fisica y swap
#   cpu     uso, nucleos, frecuencia y carga
#   red     trafico de entrada y salida en KB/s
RECURSOS=disco,discos,ram,cpu

# --- Base local del cliente y sincronizacion (v2) ---
# Cada nodo guarda sus mediciones en datos/cliente_<id>.db ANTES de enviarlas.
# Si no hay red, se quedan ahi y se entregan al reconectar. Estos numeros
# acotan cuanto puede crecer ese archivo si el nodo pasa dias sin servidor.
# Con 20.000 muestras y un intervalo de 10 s, un nodo aguanta ~55 h de corte
# sin perder nada; despues empieza a descartar lo mas viejo (y lo anota).
BUFFER_MAX_MUESTRAS=20000
BUFFER_RETENCION_HORAS=72
# Muestras por lote de recuperacion y pausa entre lotes. La pausa es control de
# flujo: sin ella, un nodo con 20.000 muestras atrasadas satura al servidor
# justo cuando los otros estan reportando normal.
SYNC_TAM_LOTE=100
SYNC_PAUSA_MS=150

# --- Reloj (v2) ---
# La hora de cada metrica la pone SIEMPRE el servidor, a partir del reloj
# monotonico del cliente. Cambiar la hora de un nodo no mueve ni una fila.
# Este umbral solo decide a partir de que desvio se deja constancia de que ese
# nodo tiene el reloj mal.
UMBRAL_RELOJ_SEG=60

# --- Fallos intermitentes (v2) ---
# PING de aplicacion: detecta una conexion "medio abierta" (el nodo manda pero
# no recibe) que ni el timeout de recv ni el keepalive del sistema detectan a
# tiempo. 0 lo desactiva.
PERIODO_PING_SEG=15
# Cuantos cortes en la ventana hacen que un nodo se marque INTERMITENTE.
INTERMITENCIA_CAIDAS=3
INTERMITENCIA_VENTANA_MIN=10

# --- WebSocket del dashboard (v2) ---
# Cada cuanto la API mira la base y EMPUJA el estado a los navegadores. El
# dashboard ya no hace F5 ni polling. Si no hay nadie conectado, no consulta.
PERIODO_WS_MS=1000
WS_MAX_CLIENTES=50

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Hilos de FastAPI = techo de conexiones a MySQL de este proceso.
# El valor por defecto de Starlette es 40: demasiado para el plan gratuito de
# Aiven cuando ademas corre el servidor de sockets.
API_HILOS=6
